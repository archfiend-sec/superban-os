# ==============================================================================
#  SUPERBAN OS v6.0 SOVEREIGN APEX // ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 1. Obtain your API ID and API HASH from: https://my.telegram.org
# 2. Enter your phone number with international country code (e.g. +1234567890)
# 3. Rename this file to '.env' before starting the application.

# Mandatory Telegram API Credentials
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+1234567890

# Optional: Telethon StringSession (Auto-generated on first login)
# Once generated, the app can run 100% headless on cloud servers without re-authenticating.
TELEGRAM_STRING_SESSION=

# Server Configuration
HOST=0.0.0.0
PORT=8000
HEADLESS=0
